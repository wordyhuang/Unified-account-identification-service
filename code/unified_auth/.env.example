# ==================== Django ====================
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True

# ==================== 数据库 ====================
# 开发环境推荐使用 SQLite
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# 生产环境使用 MySQL 时取消下面注释
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=unified_auth
# DB_USER=root
# DB_PASSWORD=1VuxzsXfEZLBAFIZ
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ==================== JWT ====================
JWT_SECRET_KEY=your-jwt-secret-key

# ==================== 超级管理员账户（JSON 数组） ====================
# 用于中间件认证，不支持动态修改，修改后需重启服务
SUPERADMIN_ACCOUNTS=[{"username":"admin","password":"admin123"}]

# ==================== 初始化管理员密码 ====================
# 执行 python manage.py init_data 时创建的管理员用户密码
ADMIN_INIT_PASSWORD=admin123

# ==================== Mock 模式总开关 ====================
# 禁止在生产环境开启！仅用于本地开发时模拟第三方服务
# True - 启用 Mock 模式（第三方API调用失败时使用假数据）
# False - 禁用 Mock 模式（第三方API调用失败时返回错误）
MOCK_ENABLED=False